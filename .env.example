HA_WEBHOOK_URL=http://server:8123/api/webhook/YOUR_LONG_RANDOM_WEBHOOK_ID
RELAY_PORT=18425
LOG_LEVEL=INFO
REQUEST_TIMEOUT=10
RETRY_COUNT=3

# --- Storage backend -------------------------------------------------------
# local = serve images from the relay itself (LAN only)
# r2    = upload to Cloudflare R2 and hand out presigned URLs (works anywhere)
STORAGE_BACKEND=local

# --- local backend ---------------------------------------------------------
# Only used when the relay serves images itself. Leave PUBLIC_BASE_URL empty to
# derive it from the incoming request.
PUBLIC_BASE_URL=
# Delete stored images after this many minutes. 0 disables cleanup.
IMAGE_RETENTION_MINUTES=60

# --- r2 backend ------------------------------------------------------------
# Required when STORAGE_BACKEND=r2.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Set to "eu" for a bucket created with EU jurisdiction, otherwise leave empty.
R2_JURISDICTION=
# Optional: override the endpoint entirely (other S3-compatible services).
R2_ENDPOINT_URL=
# Optional: store objects under a prefix, e.g. doorbell
R2_KEY_PREFIX=
# How long a presigned URL stays valid, in seconds. The object is deleted
# after the same period.
URL_TTL_SECONDS=900
