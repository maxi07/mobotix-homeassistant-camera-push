HA_WEBHOOK_URL=http://server:8123/api/webhook/YOUR_LONG_RANDOM_WEBHOOK_ID
RELAY_PORT=18425
LOG_LEVEL=INFO
REQUEST_TIMEOUT=10
RETRY_COUNT=3

# ===========================================================================
# Storage backend
# ===========================================================================
# local = the relay serves images itself. Works only while the phone is on the
#         same network as the relay.
# r2    = upload to Cloudflare R2 and hand out presigned URLs. Works anywhere,
#         without exposing the relay or Home Assistant to the internet.
#
# Fill in ONLY the section matching your choice. The other section is ignored.
STORAGE_BACKEND=local

# ===========================================================================
# Section for STORAGE_BACKEND=local   (ignored when using r2)
# ===========================================================================
# Leave empty to derive the base URL from the incoming request. Set it only
# when the generated address must differ (e.g. behind a reverse proxy).
PUBLIC_BASE_URL=
# Delete stored images after this many minutes. 0 keeps them forever.
IMAGE_RETENTION_MINUTES=60

# ===========================================================================
# Section for STORAGE_BACKEND=r2      (ignored when using local)
# ===========================================================================

# --- Always required -------------------------------------------------------
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=***

# --- Endpoint: pick EITHER option A OR option B, not both ------------------
#
# Option A (simplest): paste the S3 endpoint Cloudflare showed you when you
# created the API token. It looks like:
#     https://<account-id>.eu.r2.cloudflarestorage.com      (EU bucket)
#     https://<account-id>.r2.cloudflarestorage.com         (standard bucket)
# Do NOT append the bucket name — that belongs in R2_BUCKET above.
# When this is set, R2_ACCOUNT_ID and R2_JURISDICTION are NOT needed.
R2_ENDPOINT_URL=
#
# Option B: let the relay build the endpoint for you. Only used when
# R2_ENDPOINT_URL is empty. R2_ACCOUNT_ID is the hex ID from your Cloudflare
# dashboard; set R2_JURISDICTION=eu for a bucket created with EU jurisdiction,
# otherwise leave it empty.
R2_ACCOUNT_ID=
R2_JURISDICTION=

# --- Optional --------------------------------------------------------------
# Store objects under a prefix, e.g. doorbell
R2_KEY_PREFIX=
# How long a presigned URL stays valid, in seconds. The relay deletes the
# object once this period has passed. 900 = 15 minutes.
URL_TTL_SECONDS=900
